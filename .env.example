# ─── OpenAI ──────────────────────────────────────────────────────────────────
# All AI text + image generation runs through OpenAI.
OPENAI_API_KEY=your_openai_api_key_here
# Chat model for GM and streaming (default: gpt-4o).
# OPENAI_CHAT_MODEL=gpt-4o

# ─── Supabase ────────────────────────────────────────────────────────────────
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Direct DB URLs (Supabase project settings → Database)
DATABASE_URL=postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://postgres:[password]@[host]:5432/postgres?sslmode=require
# Dev-only: set if local Supabase complains about SELF_SIGNED_CERT_IN_CHAIN
# DATABASE_SSL_REJECT_UNAUTHORIZED=0

# ─── Stripe (one-time credit purchases only — no subscriptions) ──────────────
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ─── Contact / Feedback email (optional) ─────────────────────────────────────
# Gmail example: host=smtp.gmail.com, port=587, secure=false, use an App Password
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com
CONTACT_EMAIL=contact@yourdomain.com

# ─── Google Gemini (optional, used as a cheaper fallback chat model) ────────
GEMINI_API_KEY=

# ─── Analytics (optional) ────────────────────────────────────────────────────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA4_PROPERTY_ID=
