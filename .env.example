# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here
# Chat model for GM and streaming (default: gpt-4o). Use gpt-5.2-instant etc. if you have access.
# OPENAI_CHAT_MODEL=gpt-4o

# Cartesia TTS (game-oriented, low-latency) — https://play.cartesia.ai/keys
CARTESIA_API_KEY=your_cartesia_api_key_here

# Avatar Generation Configuration
# Options: "dalle-3" (default), "flux", "stable-diffusion"
# FLUX and stable-diffusion require REPLICATE_API_TOKEN
AVATAR_GENERATION_MODEL=dalle-3
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database URLs (from Supabase project settings)
# These are used for direct database connections (optional, for migrations, etc.)
DATABASE_URL=postgresql://postgres:[password]@[host]:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
DIRECT_URL=postgresql://postgres:[password]@[host]:5432/postgres?sslmode=require
